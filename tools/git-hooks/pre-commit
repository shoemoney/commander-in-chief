#!/usr/bin/env bash
# Desert-reskin asset honesty check. Not auto-installed by git -- enable
# once with:
#   git config core.hooksPath tools/git-hooks
#
# See art_reviews/desert_reskin/winners.md's "Keeping this honest before
# you commit" section for why this exists and the manual-run alternative.
#
# No-op for any commit that doesn't touch a desert-reskin path, so it
# doesn't tax unrelated commits. When it does apply, it reruns every
# desert-reskin self-test plus verify_desert_winners.py and blocks the
# commit if any of them fail (a hand-edited sprite that drifted from its
# recorded winner, a bumped "winner" that was never applied, etc).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -qE '^(art_candidates/desert_reskin/|assets/legacy-art/|tools/.*desert)'; then
    exit 0
fi

echo "desert-reskin paths touched -- running the desert asset self-tests + winner audit"
python3 tools/test_generate_desert_variants.py
python3 tools/test_apply_desert_winner.py
python3 tools/test_verify_desert_winners.py
python3 tools/test_build_desert_preview.py
python3 tools/verify_desert_winners.py
