diff --git a/tests/test_endless.gd b/tests/test_endless.gd
index a86e9c6d..a5f6f2f3 100644
--- a/tests/test_endless.gd
+++ b/tests/test_endless.gd
@@ -744,6 +744,34 @@ func test_arena_shift_recycles_a_full_table() -> void:
