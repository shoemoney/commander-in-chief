 	main.free()
 
 
+func test_perk_equipped_endless_run_still_verifies_and_banks() -> void:
+	# THE cross-system regression. Perks were applied post-construction in _reset()
+	# but Replay rebuilt its verification sim from seed/mode/assist/hard/chapter
+	# ONLY -- so a perk-equipped run re-simulated as an UNEQUIPPED one. Measured on
+	# seed 0x5EED / 1800 scripted ticks: equipped reaches wave 2 at 1300 pts, the
+	# same inputs unequipped wipe on wave 1 at 0. verify_score() therefore failed,
+	# _apply_score_verdict took the else branch, and _record_run -- the ONLY path to
+	# the Hall of Fame, lifetime stats, the Steam upload and VP income -- never ran.
+	# Net effect: the first perk you ever bought stopped every later Endless run
+	# from banking, so you could never earn VP for another one. Each half of this
+	# was covered alone; nothing crossed them. This does.
+	var main = _PerkGateMain.new()
+	main._sfx = _NullSfx.new()
+	main._perk_levels = {MainScript.PERK_VEST: 1, MainScript.PERK_CHEST: 2, MainScript.PERK_TOKEN: 1}
+	main._endless = true
+	main._seed_override = 0x5EED   # one-shot: pin the run so the measured divergence above holds
+	main._reset()
+	Runner.T.ok(main.sim.war_chest > 0 and main.sim.players[0]["vest"] and main.sim.tokens > 0,
+		"sanity: this run really did start perk-equipped")
+
+	# Drive it exactly the way _physics_process does -- the same inputs into the
+	# sim and the recorder (src/main.gd: `_recorder.record_tick(inputs)`).
+	for tick in 1800:
+		var inputs := [Det.scripted_input(tick, 0)]
+		main._recorder.record_tick(inputs)
+		main.sim.step(inputs)
+	Runner.T.ok(main.sim.score > 0, "the scripted run actually scored something worth verifying")
+
+	var verified: bool = main._recorder.verify_score(main.sim.score)
+	Runner.T.ok(verified, "a perk-equipped run's OWN replay must still reproduce its score")
+	main._apply_score_verdict(main.sim.score, verified)
+	Runner.T.eq(main.record_run_calls, 1,
+		"...and must therefore still reach the one bank path (Hall / lifetime / Steam / VP)")
+	Runner.T.eq(main.last_recorded_score, main.sim.score, "the banked score is the verified one")
+
+	# Anchor: the SAME frames with the perk tiers stripped must NOT verify. Without
+	# this the test could pass vacuously if perks stopped mattering; with it, this
+	# case is provably red against the pre-fix Replay.
+	var blind := Replay.new()
+	blind.seed_value = main._recorder.seed_value
+	blind.mode = main._recorder.mode
+	blind.player_count = main._recorder.player_count
+	blind.frames = main._recorder.frames
+	Runner.T.ok(not blind.verify_score(main.sim.score),
+		"anchor: the identical frames replayed UNEQUIPPED diverge -- the exact pre-fix failure")
+	main.free()
+
+
+func test_perk_tiers_survive_a_replay_save_load_round_trip() -> void:
+	# The carried tiers are worthless if they don't survive the on-disk format,
+	# and OLD replays (recorded before the field existed) must still load and
+	# verify -- they were necessarily recorded unequipped, hence the 0 default.
+	var rep := Replay.new()
+	rep.seed_value = 0x5EED
+	rep.mode = "endless"
+	rep.perk_vest = 1
+	rep.perk_chest = 2
+	rep.perk_token = 1
+	var path := "user://tmp_test_perk_replay.json"
+	if FileAccess.file_exists(path):
+		DirAccess.remove_absolute(path)
+	Runner.T.eq(rep.save(path), OK, "the replay writes")
+	var loaded := Replay.load_from(path)
+	Runner.T.ok(loaded != null, "the replay reads back")
+	Runner.T.eq(loaded.perk_vest, 1, "VETERAN VEST tier survives the round trip")
+	Runner.T.eq(loaded.perk_chest, 2, "HEAD START tier survives the round trip")
+	Runner.T.eq(loaded.perk_token, 1, "SIGNAL FLARE tier survives the round trip")
+
+	# A pre-existing file has no perk keys at all -- it must still load, at 0.
+	var old := rep.to_dict()
+	old.erase("perk_vest")
+	old.erase("perk_chest")
+	old.erase("perk_token")
+	Runner.T.eq(Replay.save_dict(old, path), OK, "the legacy-shaped replay writes")
+	var legacy := Replay.load_from(path)
+	Runner.T.ok(legacy != null, "a replay predating the perk fields still loads (back-compat)")
+	Runner.T.eq(legacy.perk_vest + legacy.perk_chest + legacy.perk_token, 0,
+		"...defaulting to no perks, which is what such a run was actually recorded with")
+	DirAccess.remove_absolute(path)
+
+
 func test_unowned_perks_leave_a_fresh_endless_run_untouched() -> void:
 	var main: Node2D = MainScript.new()
 	main._sfx = _NullSfx.new()
