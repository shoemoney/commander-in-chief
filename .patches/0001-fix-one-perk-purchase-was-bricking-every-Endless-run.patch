 var assist: bool = false   # accessibility 2-hit vest — MUST be restored on replay or the sim diverges
 var hard: bool = false     # NG+ HARD spawn curve — alters the RNG stream + checksum, restore on replay
 var chapter: int = 1       # authored-campaign-and-modes: Arcade's jump_to_chapter() start gate (1 = no jump)
+# endless-meta-retention: owned Veteran Perk tiers. main._reset() applies these
+# POST-construction exactly like the assist vest, so they belong here for exactly
+# the same reason: without them a perk-equipped Endless run re-sims as an
+# unequipped one, verify_score() fails, and _apply_score_verdict skips
+# _record_run -- i.e. the first perk you buy permanently stops every later run
+# from banking to the Hall / lifetime stats / Steam / VP income.
+const PERK_CHEST_BONUS := 60   # War Chest per owned HEAD START tier (main.gd aliases this const)
+var perk_vest: int = 0
+var perk_chest: int = 0
+var perk_token: int = 0
 var frames: Array = []   # each element: Array of per-player encoded SimInput ([move_x,move_y,aim_x,aim_y,flags])
 # replay-validated-leaderboards: the score the live run's sim reported, carried
 # alongside the recorded inputs so ANY leaderboard/Hall submission can be
@@ -43,6 +53,7 @@ func record_tick(inputs: Array) -> void:
 func to_dict() -> Dictionary:
 	return {"magic": MAGIC, "seed": seed_value, "mode": mode,
 		"players": player_count, "assist": assist, "hard": hard, "chapter": chapter,
+		"perk_vest": perk_vest, "perk_chest": perk_chest, "perk_token": perk_token,
 		"frames": frames, "score": claimed_score, "verified": verified}
 
 
@@ -119,6 +130,12 @@ static func load_from(path: String) -> Replay:
 	r.assist = bool(data.get("assist", false))
 	r.hard = bool(data.get("hard", false))
 	r.chapter = int(data.get("chapter", 1))   # pre-existing replays predate Arcade -> chapter 1 (no jump)
+	# Perk tiers default to 0 so replays recorded before this field still load AND
+	# still verify (an old file was necessarily recorded by a build that only ever
+	# ran unequipped -- or by the broken one, whose runs never verified anyway).
+	r.perk_vest = int(data.get("perk_vest", 0))
+	r.perk_chest = int(data.get("perk_chest", 0))
+	r.perk_token = int(data.get("perk_token", 0))
 	r.frames = data["frames"]
 	# score/verified default 0/false for pre-existing replays that predate
 	# replay-validated leaderboards.
@@ -135,9 +152,11 @@ func _new_sim() -> SimWorld:
 	var sim := SimWorld.new(seed_value, player_count, mode)
 	sim.assist_mode = assist
 	sim.hard = hard
-	if assist:
+	if assist or perk_vest > 0:
 		for pl in sim.players:
 			pl["vest"] = true
+	sim.war_chest += PERK_CHEST_BONUS * perk_chest
+	sim.tokens += perk_token
