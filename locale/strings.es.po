# TRANSLATOR NOTE: preserve every %s / %d / %%d verbatim (GDScript formats them
# AFTER TranslationServer.translate() runs, so the placeholder must survive the
# lookup unchanged). hud.gd's VO/bark caption strip wraps at CAPTION_MAX_W=560px
# (see HudIcons._wrap_caption) -- word-wrapped for space-delimited scripts, and
# character-wrapped as a fallback for space-less scripts (Japanese/Chinese), so a
# caption line of any length is safe, but a SETTING_HELP/hint line elsewhere is
# ellipsized instead of wrapped -- keep those reasonably close to the English
# source's length where you can.

msgid "SFX: LOUDNESS OF WEAPON, HIT, AND EXPLOSION SOUNDS. SAVED AUTOMATICALLY."
msgstr "SFX: VOLUMEN DE DISPAROS, IMPACTOS Y EXPLOSIONES. SE GUARDA AUTOMÁTICAMENTE."

msgid "MUSIC: LOUDNESS OF THE BACKGROUND SOUNDTRACK. SAVED AUTOMATICALLY."
msgstr "MÚSICA: VOLUMEN DE LA BANDA SONORA. SE GUARDA AUTOMÁTICAMENTE."

msgid "RUMBLE: CONTROLLER VIBRATION ON HITS AND EXPLOSIONS. SAVED AUTOMATICALLY."
msgstr "VIBRACIÓN: VIBRACIÓN DEL MANDO EN IMPACTOS Y EXPLOSIONES. SE GUARDA AUTOMÁTICAMENTE."

msgid "REDUCE MOTION: NO SHAKE OR SCROLL, DAMPED FLASH/WARP. SAVED AUTOMATICALLY."
msgstr "REDUCIR MOVIMIENTO: SIN TEMBLOR NI SCROLL, DESTELLO/DEFORMACIÓN ATENUADOS. SE GUARDA AUTOMÁTICAMENTE."

msgid "COLORBLIND: RECOLORS GREEN CUES TO BLUE AND ADDS SHAPES. SAVED AUTOMATICALLY."
msgstr "DALTONISMO: RECOLOREA LAS SEÑALES VERDES A AZUL Y AÑADE FORMAS. SE GUARDA AUTOMÁTICAMENTE."

msgid "ASSIST: EACH LIFE TAKES TWO HITS, NOT ONE. RUNS ARE TAGGED *ASSIST. SAVED AUTOMATICALLY."
msgstr "ASISTENCIA: CADA VIDA AGUANTA DOS IMPACTOS, NO UNO. LAS PARTIDAS SE MARCAN *ASISTIDA. SE GUARDA AUTOMÁTICAMENTE."

msgid "CAPTIONS: SUBTITLES FOR COMMANDER/SPOTTER VOICE LINES. SAVED AUTOMATICALLY."
msgstr "SUBTÍTULOS: SUBTÍTULOS PARA LAS VOCES DEL COMANDANTE Y EL OBSERVADOR. SE GUARDA AUTOMÁTICAMENTE."

msgid "FULLSCREEN: FILL THE WHOLE DISPLAY INSTEAD OF A WINDOW. SAVED AUTOMATICALLY."
msgstr "PANTALLA COMPLETA: OCUPA TODA LA PANTALLA EN VEZ DE UNA VENTANA. SE GUARDA AUTOMÁTICAMENTE."

msgid "WINDOW SCALE: SIZE OF THE GAME WINDOW WHILE NOT FULLSCREEN. SAVED AUTOMATICALLY."
msgstr "ESCALA DE VENTANA: TAMAÑO DE LA VENTANA SIN PANTALLA COMPLETA. SE GUARDA AUTOMÁTICAMENTE."

msgid "TEXT SIZE: ENLARGES SMALL ON-SCREEN LABELS AND SUBTITLES. SAVED AUTOMATICALLY."
msgstr "TAMAÑO DE TEXTO: AGRANDA LAS ETIQUETAS PEQUEÑAS Y LOS SUBTÍTULOS. SE GUARDA AUTOMÁTICAMENTE."

msgid "CO-OP: ADD A SECOND LOCAL PLAYER. APPLIES TO YOUR NEXT RUN."
msgstr "COOPERATIVO: AÑADE UN SEGUNDO JUGADOR LOCAL. SE APLICA EN TU PRÓXIMA PARTIDA."

msgid "NG+ HARD: A TOUGHER SPAWN CURVE. CAMPAIGN ONLY. RUNS ARE TAGGED *HARD. APPLIES TO YOUR NEXT RUN."
msgstr "NG+ DIFÍCIL: UNA CURVA DE APARICIÓN MÁS DURA. SOLO EN CAMPAÑA. LAS PARTIDAS SE MARCAN *HARD. SE APLICA EN TU PRÓXIMA PARTIDA."

msgid "SPOTTER: \"War chest's empty, no revives!\""
msgstr "OBSERVADOR: \"¡El fondo de guerra está vacío, sin reanimaciones!\""

msgid "SPOTTER: \"Squad's wiped. Run's over.\""
msgstr "OBSERVADOR: \"Escuadrón aniquilado. Partida terminada.\""

msgid "SPOTTER: \"This is it, LAST STAND!\""
msgstr "OBSERVADOR: \"¡Esto es todo, ÚLTIMA RESISTENCIA!\""

msgid "SPOTTER: \"Enemy observer spotted!\""
msgstr "OBSERVADOR: \"¡Observador enemigo detectado!\""

msgid "SPOTTER: \"You're on a tear, keep it up!\""
msgstr "OBSERVADOR: \"¡Vas que te sales, sigue así!\""

msgid "SPOTTER: \"Core's exposed, open fire!\""
msgstr "OBSERVADOR: \"¡Núcleo al descubierto, abran fuego!\""

msgid "SPOTTER: \"Flawless gate clear!\""
msgstr "OBSERVADOR: \"¡Puerta despejada sin fallos!\""

msgid "SPOTTER: \"Ransom lost, pilot's gone!\""
msgstr "OBSERVADOR: \"¡Rescate perdido, el piloto se ha ido!\""

# TRANSLATOR NOTE: "victoly" is a deliberate r/l malapropism in the English source (a
# running joke voice tic), not a typo -- "victolia" mirrors it in Spanish; don't "fix"
# it to "victoria".
msgid "SPOTTER: \"Total victoly! Believe me!\""
msgstr "OBSERVADOR: \"¡Victolia total! Créanme.\""

msgid "SPOTTER: \"Friendly strike inbound — keep firing!\""
msgstr "OBSERVADOR: \"¡Ataque aliado entrante, seguid disparando!\""

msgid "SPOTTER: \"Pilot down, get to him!\""
msgstr "OBSERVADOR: \"¡Piloto derribado, id a por él!\""

msgid "SPOTTER: \"Shop's locked, boss incoming!\""
msgstr "OBSERVADOR: \"¡Tienda cerrada, jefe llegando!\""

msgid "SPOTTER: \"You're dry, reload!\""
msgstr "OBSERVADOR: \"¡Te has quedado sin munición, recarga!\""

msgid "PILOT: \"Don't leave me out here!\""
msgstr "PILOTO: \"¡No me dejéis aquí afuera!\""

msgid "COMMANDER: \"One man can go in and win the war for the USA.\""
msgstr "COMANDANTE: \"Un solo hombre puede entrar y ganar la guerra por los EE. UU.\""

msgid "COMMANDER: \"Move out!\""
msgstr "COMANDANTE: \"¡En marcha!\""

msgid "COMMANDER: \"Rally to me!\""
msgstr "COMANDANTE: \"¡A reagruparse conmigo!\""

msgid "COMMANDER: \"Man down!\""
msgstr "COMANDANTE: \"¡Hombre abatido!\""

msgid "COMMANDER: \"Total victory. Believe me.\""
msgstr "COMANDANTE: \"Victoria total. Créanme.\""

msgid "COMMANDER: \"Back in it!\""
msgstr "COMANDANTE: \"¡De vuelta a la lucha!\""

msgid "PIERCING ROUNDS — SHOTS PUNCH THROUGH. AIM DOWN THE COLUMN"
msgstr "MUNICIÓN PERFORANTE — LOS DISPAROS ATRAVIESAN. APUNTA A LO LARGO DE LA COLUMNA"

msgid "TRENCH GUN — 3-ROUND FAN, 2 AMMO A PULL. ON TRIPLE IT'S 5 FOR 3"
msgstr "ESCOPETA DE TRINCHERA — ABANICO DE 3 DISPAROS, 2 DE MUNICIÓN POR DISPARO. CON TRIPLE SON 5 POR 3"

msgid "TRIPLE SHOT — 3-ROUND FAN, 2 AMMO A PULL. STACK SPREAD FOR 5 FOR 3"
msgstr "DISPARO TRIPLE — ABANICO DE 3 DISPAROS, 2 DE MUNICIÓN POR DISPARO. SUMA DISPERSIÓN PARA 5 POR 3"

msgid "REND ROUNDS — YOUR MG NOW PUNCHES THROUGH RIOT SHIELDS"
msgstr "MUNICIÓN DESGARRADORA — TU AMETRALLADORA ATRAVIESA ESCUDOS ANTIDISTURBIOS"

msgid "COMMENDATION — SPEND IT FROM THE SUPPLY WHEEL"
msgstr "CONDECORACIÓN — GÁSTALA DESDE LA RUEDA DE SUMINISTROS"

msgid "MAST OVERHEAT — VACATE THE ORBIT"
msgstr "MÁSTIL SOBRECALENTADO — ABANDONA LA ÓRBITA"

msgid "SMOKE — BLINDS RIFLE AIM. NESTS STILL TRACK. SHELLS STILL FALL"
msgstr "HUMO — CIEGA FUSILES. LOS NIDOS SIGUEN RASTREANDO. LOS PROYECTILES SIGUEN CAYENDO"

msgid "FLASHBANG — DETONATES ON GRAB. INFANTRY ONLY."
msgstr "CEGADORA — DETONA AL RECOGERLA. SOLO INFANTERÍA."

msgid "BROADCAST TOWER — ENEMIES IN THE RING RUN FASTER. KILL THE MAST"
msgstr "TORRE DE RADIO — LOS ENEMIGOS DENTRO DEL ANILLO CORREN MÁS RÁPIDO. DESTRUYE EL MÁSTIL"

msgid "TALL GRASS HIDES YOU — CAMPING DRAWS A FLUSH MORTAR. KEEP MOVING"
msgstr "LA HIERBA ALTA TE OCULTA — ACAMPAR ATRAE UN MORTERO DE DESALOJO. SIGUE MOVIÉNDOTE"

msgid "THE NEST CRACKS UNDER FIRE — KEEP SHOOTING, OR GRENADE IT"
msgstr "EL NIDO SE AGRIETA BAJO FUEGO — SIGUE DISPARANDO O LANZA UNA GRANADA"

msgid "GRENADES CRACK ARMOR — [%s] — BUNKERS TAKE NO BULLETS"
msgstr "LAS GRANADAS AGRIETAN LA ARMADURA — [%s] — LOS BÚNKERES NO RESISTEN BALAS"

msgid "ARMORED — WAIT FOR THE CORE"
msgstr "BLINDADO — ESPERA AL NÚCLEO"

msgid "CLAYMORE — PLANT WITH [%s] AWAY FROM TANKS (IT HURTS BOTH SIDES)"
msgstr "CLAYMORE — COLÓCALA CON [%s] LEJOS DE LOS TANQUES (DAÑA A AMBOS BANDOS)"

msgid "FEED THE WAR CHEST TO REVIVE — [%s]"
msgstr "ALIMENTA EL FONDO DE GUERRA PARA REANIMAR — [%s]"

msgid "RESCUE THE DOWNED PILOT — TOUCH HIM, AIM AWAY — %d¢ RANSOM"
msgstr "RESCATA AL PILOTO CAÍDO — TÓCALO, APUNTA LEJOS — %d¢ DE RESCATE"

msgid "HOLD [%s] FOR THE SUPPLY WHEEL"
msgstr "MANTÉN [%s] PARA LA RUEDA DE SUMINISTROS"

msgid "AIRSTRIKES NOW LIVE IN THE SUPPLY WHEEL — HOLD [%s]"
msgstr "LOS ATAQUES AÉREOS YA ESTÁN EN LA RUEDA DE SUMINISTROS — MANTÉN [%s]"

msgid "K.I.A."
msgstr "BAJA"

msgid "BAIL OUT! %ds"
msgstr "¡SALTA! %ds"

msgid "CREW HIT! %ds"
msgstr "¡TRIPULACIÓN ALCANZADA! %ds"

msgid "ROLL"
msgstr "RODAR"

msgid "GRENADE"
msgstr "GRANADA"

msgid "SUPPLY WHEEL"
msgstr "RUEDA DE SUMINISTROS"

msgid "SELECT"
msgstr "SELECCIONAR"

msgid "BACK"
msgstr "ATRÁS"


msgid "HELD THROW — POPS AT THE ARC. TAP [%s] TO LOB IT FAR"
msgstr "LANZAMIENTO PROLONGADO — EXPLOTA EN EL ARCO. TOCA [%s] PARA LANZARLA LEJOS"

msgid "FORD WASHING OUT"
msgstr "EL VADO SE ESTÁ INUNDANDO"

msgid "HOLD [%s] TO DEPLOY EARLY"
msgstr "MANTÉN [%s] PARA DESPLEGAR ANTES"

msgid "VETERAN ARMOR — BULLETS CHIP IT. GRENADES STILL ONE-SHOT"
msgstr "BLINDAJE VETERANO — LAS BALAS LO MELLAN. LAS GRANADAS SIGUEN MATANDO DE UN GOLPE"

msgid "YOU'RE STALLING — PUSH NORTH OR MORTARS ZERO IN"
msgstr "TE ESTÁS ESTANCANDO — AVANZA AL NORTE O LOS MORTEROS TE APUNTARÁN"
