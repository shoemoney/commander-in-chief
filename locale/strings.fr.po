# TRANSLATOR NOTE: preserve every %s / %d / %%d verbatim (GDScript formats them
# AFTER TranslationServer.translate() runs, so the placeholder must survive the
# lookup unchanged). hud.gd's VO/bark caption strip wraps at CAPTION_MAX_W=560px
# (see HudIcons._wrap_caption) -- word-wrapped for space-delimited scripts, and
# character-wrapped as a fallback for space-less scripts (Japanese/Chinese), so a
# caption line of any length is safe, but a SETTING_HELP/hint line elsewhere is
# ellipsized instead of wrapped -- keep those reasonably close to the English
# source's length where you can.

msgid "SFX: LOUDNESS OF WEAPON, HIT, AND EXPLOSION SOUNDS. SAVED AUTOMATICALLY."
msgstr "SFX : VOLUME DES TIRS, IMPACTS ET EXPLOSIONS. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "MUSIC: LOUDNESS OF THE BACKGROUND SOUNDTRACK. SAVED AUTOMATICALLY."
msgstr "MUSIQUE : VOLUME DE LA BANDE SONORE. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "RUMBLE: CONTROLLER VIBRATION ON HITS AND EXPLOSIONS. SAVED AUTOMATICALLY."
msgstr "VIBRATIONS : VIBRATIONS DE LA MANETTE SUR LES IMPACTS ET EXPLOSIONS. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "REDUCE MOTION: NO SHAKE OR SCROLL, DAMPED FLASH/WARP. SAVED AUTOMATICALLY."
msgstr "RÉDUIRE LES MOUVEMENTS : SANS SECOUSSES NI SCROLL, FLASH/DÉFORMATION ATTÉNUÉS. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "COLORBLIND: RECOLORS GREEN CUES TO BLUE AND ADDS SHAPES. SAVED AUTOMATICALLY."
msgstr "DALTONISME : RECOLORE LES INDICES VERTS EN BLEU ET AJOUTE DES FORMES. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "ASSIST: EACH LIFE TAKES TWO HITS, NOT ONE. RUNS ARE TAGGED *ASSIST. SAVED AUTOMATICALLY."
msgstr "ASSISTANCE : CHAQUE VIE ENCAISSE DEUX COUPS AU LIEU D'UN. LES PARTIES SONT MARQUÉES *ASSISTÉE. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "CAPTIONS: SUBTITLES FOR COMMANDER/SPOTTER VOICE LINES. SAVED AUTOMATICALLY."
msgstr "SOUS-TITRES : SOUS-TITRES POUR LES VOIX DU COMMANDANT ET DE L'OBSERVATEUR. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "FULLSCREEN: FILL THE WHOLE DISPLAY INSTEAD OF A WINDOW. SAVED AUTOMATICALLY."
msgstr "PLEIN ÉCRAN : REMPLIT TOUT L'ÉCRAN AU LIEU D'UNE FENÊTRE. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "WINDOW SCALE: SIZE OF THE GAME WINDOW WHILE NOT FULLSCREEN. SAVED AUTOMATICALLY."
msgstr "TAILLE DE FENÊTRE : TAILLE DE LA FENÊTRE HORS PLEIN ÉCRAN. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "TEXT SIZE: ENLARGES SMALL ON-SCREEN LABELS AND SUBTITLES. SAVED AUTOMATICALLY."
msgstr "TAILLE DU TEXTE : AGRANDIT LES PETITS LIBELLÉS ET LES SOUS-TITRES. ENREGISTRÉ AUTOMATIQUEMENT."

msgid "CO-OP: ADD A SECOND LOCAL PLAYER. APPLIES TO YOUR NEXT RUN."
msgstr "COOP : AJOUTE UN DEUXIÈME JOUEUR LOCAL. S'APPLIQUE À VOTRE PROCHAINE PARTIE."

msgid "NG+ HARD: A TOUGHER SPAWN CURVE. CAMPAIGN ONLY. RUNS ARE TAGGED *HARD. APPLIES TO YOUR NEXT RUN."
msgstr "NG+ DIFFICILE : UNE COURBE D'APPARITION PLUS DURE. CAMPAGNE UNIQUEMENT. LES PARTIES SONT MARQUÉES *HARD. S'APPLIQUE À VOTRE PROCHAINE PARTIE."

msgid "SPOTTER: \"War chest's empty, no revives!\""
msgstr "OBSERVATEUR : « Le trésor de guerre est vide, plus de réanimations ! »"

msgid "SPOTTER: \"Squad's wiped. Run's over.\""
msgstr "OBSERVATEUR : « Escouade anéantie. Partie terminée. »"

msgid "SPOTTER: \"This is it, LAST STAND!\""
msgstr "OBSERVATEUR : « Ça y est, DERNIER BASTION ! »"

msgid "SPOTTER: \"Enemy observer spotted!\""
msgstr "OBSERVATEUR : « Observateur ennemi repéré ! »"

msgid "SPOTTER: \"You're on a tear, keep it up!\""
msgstr "OBSERVATEUR : « Vous êtes en feu, continuez ! »"

msgid "SPOTTER: \"Core's exposed, open fire!\""
msgstr "OBSERVATEUR : « Noyau exposé, ouvrez le feu ! »"

msgid "SPOTTER: \"Flawless gate clear!\""
msgstr "OBSERVATEUR : « Porte franchie sans dégâts ! »"

msgid "SPOTTER: \"Ransom lost, pilot's gone!\""
msgstr "OBSERVATEUR : « Rançon perdue, le pilote est parti ! »"

# TRANSLATOR NOTE: "victoly" is a deliberate r/l malapropism in the English source (a
# running joke voice tic), not a typo -- "victoile" mirrors it in French; don't "fix"
# it to "victoire".
msgid "SPOTTER: \"Total victoly! Believe me!\""
msgstr "OBSERVATEUR : « Victoile totale ! Croyez-moi. »"

msgid "SPOTTER: \"Friendly strike inbound — keep firing!\""
msgstr "OBSERVATEUR : « Frappe alliée entrante — continuez à tirer ! »"

msgid "SPOTTER: \"Pilot down, get to him!\""
msgstr "OBSERVATEUR : « Pilote abattu, allez-y ! »"

msgid "SPOTTER: \"Shop's locked, boss incoming!\""
msgstr "OBSERVATEUR : « Boutique fermée, le boss arrive ! »"

msgid "SPOTTER: \"You're dry, reload!\""
msgstr "OBSERVATEUR : « Chargeur vide, rechargez ! »"

msgid "PILOT: \"Don't leave me out here!\""
msgstr "PILOTE : « Ne me laissez pas ici ! »"

msgid "COMMANDER: \"One man can go in and win the war for the USA.\""
msgstr "COMMANDANT : « Un seul homme peut y aller et gagner la guerre pour les USA. »"

msgid "COMMANDER: \"Move out!\""
msgstr "COMMANDANT : « En avant ! »"

msgid "COMMANDER: \"Rally to me!\""
msgstr "COMMANDANT : « Ralliez-vous à moi ! »"

msgid "COMMANDER: \"Man down!\""
msgstr "COMMANDANT : « Homme à terre ! »"

msgid "COMMANDER: \"Total victory. Believe me.\""
msgstr "COMMANDANT : « Victoire totale. Croyez-moi. »"

msgid "COMMANDER: \"Back in it!\""
msgstr "COMMANDANT : « De retour au combat ! »"

msgid "PIERCING ROUNDS — SHOTS PUNCH THROUGH. AIM DOWN THE COLUMN"
msgstr "MUNITIONS PERFORANTES — LES TIRS TRANSPERCENT. VISEZ DANS L'AXE DE LA COLONNE"

msgid "TRENCH GUN — 3-ROUND FAN, 2 AMMO A PULL. ON TRIPLE IT'S 5 FOR 3"
msgstr "FUSIL À POMPE DE TRANCHÉE — ÉVENTAIL DE 3 TIRS, 2 MUNITIONS PAR PRESSION. AVEC TRIPLE, C'EST 5 POUR 3"

msgid "TRIPLE SHOT — 3-ROUND FAN, 2 AMMO A PULL. STACK SPREAD FOR 5 FOR 3"
msgstr "TIR TRIPLE — ÉVENTAIL DE 3 TIRS, 2 MUNITIONS PAR PRESSION. CUMULEZ AVEC DISPERSION POUR 5 POUR 3"

msgid "REND ROUNDS — YOUR MG NOW PUNCHES THROUGH RIOT SHIELDS"
msgstr "MUNITIONS DÉCHIRANTES — VOTRE MITRAILLEUSE TRANSPERCE LES BOUCLIERS ANTI-ÉMEUTE"

msgid "SMOKE — BLINDS RIFLE AIM. NESTS STILL TRACK. SHELLS STILL FALL"
msgstr "FUMIGÈNE — AVEUGLE LES FUSILS. LES NIDS SUIVENT ENCORE. LES OBUS TOMBENT QUAND MÊME"

msgid "FLASHBANG — DETONATES ON GRAB. INFANTRY ONLY."
msgstr "FLASHBANG — EXPLOSE AU RAMASSAGE. INFANTERIE UNIQUEMENT."

msgid "BROADCAST TOWER — ENEMIES IN THE RING RUN FASTER. KILL THE MAST"
msgstr "TOUR DE DIFFUSION — LES ENNEMIS DANS LE CERCLE COURENT PLUS VITE. DÉTRUISEZ LE MÂT"

msgid "TALL GRASS HIDES YOU — CAMPING DRAWS A FLUSH MORTAR. KEEP MOVING"
msgstr "LES HAUTES HERBES VOUS CACHENT — CAMPER ATTIRE UN MORTIER DE DÉLOGEMENT. CONTINUEZ À BOUGER"

msgid "THE NEST CRACKS UNDER FIRE — KEEP SHOOTING, OR GRENADE IT"
msgstr "LE NID SE FISSURE SOUS LE FEU — CONTINUEZ À TIRER OU DÉGOUPILLEZ UNE GRENADE"

msgid "GRENADES CRACK ARMOR — [%s] — BUNKERS TAKE NO BULLETS"
msgstr "LES GRENADES FISSURENT LE BLINDAGE — [%s] — LES BUNKERS N'ENCAISSENT PAS LES BALLES"

msgid "ARMORED — WAIT FOR THE CORE"
msgstr "BLINDÉ — ATTENDEZ LE NOYAU"

msgid "CLAYMORE — PLANT WITH [%s] AWAY FROM TANKS (IT HURTS BOTH SIDES)"
msgstr "CLAYMORE — POSEZ-LA AVEC [%s] LOIN DES CHARS (BLESSE LES DEUX CAMPS)"

msgid "FEED THE WAR CHEST TO REVIVE — [%s]"
msgstr "ALIMENTEZ LE TRÉSOR DE GUERRE POUR RÉANIMER — [%s]"

msgid "RESCUE THE DOWNED PILOT — TOUCH HIM, AIM AWAY — %d¢ RANSOM"
msgstr "SAUVEZ LE PILOTE ABATTU — TOUCHEZ-LE, VISEZ AILLEURS — RANÇON DE %d¢"

msgid "HOLD [%s] FOR THE SUPPLY WHEEL"
msgstr "MAINTENEZ [%s] POUR LA ROUE DE RAVITAILLEMENT"

msgid "AIRSTRIKES NOW LIVE IN THE SUPPLY WHEEL — HOLD [%s]"
msgstr "LES FRAPPES AÉRIENNES SONT DÉSORMAIS DANS LA ROUE DE RAVITAILLEMENT — MAINTENEZ [%s]"

msgid "K.I.A."
msgstr "MORT AU COMBAT"

msgid "BAIL OUT! %ds"
msgstr "SAUTEZ ! %ds"

msgid "CREW HIT! %ds"
msgstr "ÉQUIPAGE TOUCHÉ ! %ds"

msgid "ROLL"
msgstr "ROULADE"

msgid "GRENADE"
msgstr "GRENADE"

msgid "SUPPLY WHEEL"
msgstr "ROUE DE RAVITAILLEMENT"

msgid "SELECT"
msgstr "VALIDER"

msgid "BACK"
msgstr "RETOUR"


msgid "HELD THROW — POPS AT THE ARC. TAP [%s] TO LOB IT FAR"
msgstr "LANCER MAINTENU — ÉCLATE AU SOMMET. TAPEZ [%s] POUR LE LOBER LOIN"

msgid "FORD WASHING OUT"
msgstr "LE GUÉ EST EMPORTÉ"

msgid "HOLD [%s] TO DEPLOY EARLY"
msgstr "MAINTENEZ [%s] POUR DÉPLOYER PLUS TÔT"

msgid "VETERAN ARMOR — BULLETS CHIP IT. GRENADES STILL ONE-SHOT"
msgstr "BLINDAGE VÉTÉRAN — LES BALLES L'ÉBRÈCHENT. LES GRENADES TUENT TOUJOURS D'UN COUP"

msgid "YOU'RE STALLING — PUSH NORTH OR MORTARS ZERO IN"
msgstr "VOUS PIÉTINEZ — POUSSEZ AU NORD OU LES MORTIERS VOUS ENCADRENT"
