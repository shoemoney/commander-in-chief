.godot/
build/
*.tmp
tmp_*

# OS / tool cruft
.DS_Store
**/.DS_Store
.opencode/
tmp/

# Internal agent tooling / notes — must never ship in a public release
.claude/

# python bytecode cache
__pycache__/
*.pyc

.shoop/

# shoop asset-candidate scratch (generators re-create these; not source of
# truth). Ignore contents via /** (not a bare directory rule) so the
# .gdignore exception below can actually apply — git can't re-include a
# file whose parent directory itself is excluded — and so any future scratch
# subdirectory is covered regardless of nesting depth.
art_candidates/**
# ...except the Godot editor-ignore marker itself, so a fresh clone's very
# first --import never scans whatever raw candidate renders happen to be
# sitting in that scratch dir (they're throwaway and not always valid PNGs).
!art_candidates/.gdignore

# regen_entities.py review scratch (promote via --install, never commit)
*.regen.png
*.regen.png.import
.aaa/
reviews/
reviewer/
art_reviews/
assets_src/
!assets_src/style_bible.md
art_candidates/
PR_ISSUES.MD
docs/research/
ASSETS.md
tools/purge_history.sh
Backlog-raw-ledger.md
