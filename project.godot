; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Commander In Chief"
config/description="Commander In Chief — a deterministic twin-stick vertical run-and-gun. By Big IT Game Studios, a ShoeMoney company."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[debug]

; Debug builds only (the editor binary the tests run under) — the shipped release template is
; unaffected. run_tests.gd reads this log back to fail the suite on any engine ERROR: line; see
; the engine-error gate there. max_log_files is raised so parallel Godot runs on the same project
; can't rotate a live run's log out from under it.
file_logging/enable_file_logging.debug=true
file_logging/max_log_files.debug=24

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"



[importer_defaults]

texture={
"compress/mode": 2
}

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.es.po", "res://locale/strings.fr.po", "res://locale/strings.ja.po")

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
