; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Commander In Chief"
config/description="Commander In Chief — a deterministic twin-stick vertical run-and-gun. By Big IT Game Studios, a ShoeMoney company."
config/version="1.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[debug]

file_logging/enable_file_logging.debug=true
file_logging/max_log_files.debug=24

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
; Responsive-ui: viewport 640x360 + viewport keep integer preserves pixel-perfect
; playfield. On ultrawide (21:9 3440x1440, 32:9 5120x1440) the engine pillarboxes
; with black bars — HUD/menu stay in visible_rect ∩ OS safe area (notch) via
; MarginContainer safe insets in hud.gd / menu.gd and main.gd's
; get_visible_rect() centering, so bands and labels never sit on black bars.
; Supported: 16:9 (640x360, 1280x720, 1920x1080) and 21:9/32:9 pillarbox;
; portrait letterboxes. Keep integer letterbox.
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/stretch/aspect="keep"

[importer_defaults]

texture={
"compress/mode": 0
}

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.es.po", "res://locale/strings.fr.po", "res://locale/strings.ja.po")

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
