; Engine configuration file.
; Project Ikari — deterministic twin-stick vertical run-and-gun (P0 greybox).

config_version=5

[application]

config/name="Project Ikari"
config/description="Modern remake of the classic vertical-scrolling run-and-gun. P0 greybox prototype."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/scale_mode="integer"

[importer_defaults]

; New textures default to VRAM-compressed (mode 2) — three separate art drops
; (legacy-art bakes, asset-loop p2, brand glyphs) each landed Lossless and re-grew
; the VRAM debt the opt-loop keeps collecting. CPU-read art (custom cursors,
; anything .get_image()d without decompress) must OPT OUT with an explicit
; compress/mode=0 in its .import.
texture={
"compress/mode": 2
}

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=3
anti_aliasing/quality/msaa_2d=1
