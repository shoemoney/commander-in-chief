{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/goals/goal.schema.json",
  "title": "goals skill state file (.goals/<id>.json)",
  "description": "Machine state for one goal. Source of truth; the optional .md human view is generated from this file. schema_version matches the skill's frontmatter metadata.version that wrote the file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "objective",
    "status",
    "created_at",
    "updated_at",
    "definition_of_done",
    "evidence_requirements",
    "stop_policy",
    "evaluator",
    "iteration",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Format version = skill metadata.version that wrote this file. Validate against the schema of this version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,49}$",
      "description": "Slug; equals the filename without extension. Immutable after creation."
    },
    "title": {
      "type": "string",
      "description": "Short human label. Optional; never used by the evaluation gate."
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence naming the final, verifiable state. Immutable once status leaves draft."
    },
    "status": {
      "enum": ["draft", "active", "paused", "blocked", "complete", "failed"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "activated_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "completed_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "context": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Facts the executor cannot derive: absolute paths, anchors to read first, prior decisions."
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Low-risk ambiguity resolved by statement rather than question."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Hard rules and out-of-scope: what must not be touched, broken, or weakened."
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "description": "1-5 binary pass/fail items. More than 5 means split the goal.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "evidence_kind", "status"],
        "properties": {
          "id": { "type": "string", "description": "Stable item id, e.g. dod-1." },
          "check": { "type": "string", "minLength": 1, "description": "One binary pass/fail criterion." },
          "evidence_kind": {
            "enum": ["command", "artifact", "test", "runtime", "source", "review"]
          },
          "status": {
            "enum": ["pending", "met", "unmet"],
            "default": "pending",
            "description": "Set only by evaluation-gate verdicts, never by the worker directly."
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Raw proof appended across iterations: command + exit code, path, count, parse result."
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_surface", "required", "substitutions_allowed"],
      "properties": {
        "proof_surface": {
          "enum": ["transcript", "files", "commands", "runtime", "mixed"],
          "description": "Where the judge looks for proof."
        },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Concrete proof expectations: counts, named files, exact cases, timings, before/after states."
        },
        "substitutions_allowed": {
          "type": "boolean",
          "default": false,
          "description": "When false, demo data, fixtures, mocks, and nearby examples are supporting evidence only."
        }
      }
    },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "max_turns", "deadline", "token_budget", "on_bound_reached"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "default": 25 },
        "max_turns": { "type": "integer", "minimum": 1, "default": 100 },
        "deadline": { "type": ["string", "null"], "format": "date-time", "default": null },
        "token_budget": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "on_bound_reached": {
          "enum": ["failed", "blocked"],
          "default": "failed",
          "description": "Terminal status when a bound trips. blocked only when the bound is truly an external wait."
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instructions"],
      "properties": {
        "kind": {
          "enum": ["deterministic", "reviewer-subagent", "user"],
          "description": "Who judges each iteration. Never the worker itself."
        },
        "instructions": {
          "type": "string",
          "description": "What the judge checks, phrased as an evidence checklist."
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "turns_used", "tokens_used"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "default": 0, "description": "Evaluation cycles completed." },
        "turns_used": { "type": "integer", "minimum": 0, "default": 0 },
        "tokens_used": { "type": "integer", "minimum": 0, "default": 0, "description": "0 when untracked." }
      }
    },
    "history": {
      "type": "array",
      "default": [],
      "description": "Append-only. One entry per iteration; never rewrite or delete entries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "ts", "actions", "evidence", "evaluation"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1 },
          "ts": { "type": "string", "format": "date-time" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "unmet", "notes"],
            "properties": {
              "verdict": { "enum": ["continue", "complete", "blocked"] },
              "unmet": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Exact questions or decisions when blocked, with the smallest next user action."
    },
    "completion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "default": null,
      "description": "Filled only at status complete.",
      "required": ["met_criteria", "changed_files", "checks", "remaining_risks", "summary"],
      "properties": {
        "met_criteria": { "type": "array", "items": { "type": "string" } },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "type": "string" } },
        "remaining_risks": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    }
  }
}
